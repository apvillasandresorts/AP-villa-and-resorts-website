{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(open *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(gh secret set ANTHROPIC_API_KEY*)",
      "Bash(gh repo delete*)"
    ]
  }
}
